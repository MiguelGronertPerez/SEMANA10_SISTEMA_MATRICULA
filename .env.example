# A-06 · Configuración de Entorno (Ejemplo)
# Sistema de Matrículas - Universidad Católica Sedes Sapientiae (UCSS)

# Configuración del Servidor API
PORT=3000
NODE_ENV=development
API_PREFIX=/api

# Seguridad y Autenticación
JWT_SECRET=super_secret_jwt_key_ucss_matriculas_2027
JWT_EXPIRES_IN=2h
BCRYPT_SALT_ROUNDS=10

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=matriculas_db
DB_USER=postgres
DB_PASSWORD=secret_password

# Caché Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Integración con Sistema de Tesorería (Servicio Externo)
TESORERIA_API_URL=https://tesoreria.ucss.edu.pe/api/v1
TESORERIA_TIMEOUT_MS=10000

# Servicio de Correo Electrónico (SMTP)
SMTP_HOST=smtp.ucss.edu.pe
SMTP_PORT=587
SMTP_USER=notificaciones@ucss.edu.pe
SMTP_PASS=notif_secret_pass
SMTP_FROM="Sistema de Matriculas UCSS" <notificaciones@ucss.edu.pe>
